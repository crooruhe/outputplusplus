# Copy me to .env (never commit .env, obviously)
# The library technically reads these, in spirit.
OPP_LOG_LEVEL=INFO
OPP_COLORS=ON
OPP_FEELINGS=HURT
# Base URL for the "API" (one GET request, unauthenticated, living its best life)
OPP_API_BASE=https://api.github.com
# How dramatic the CLI output should be (float, 0.0 - 100.0)
OPP_DRAMA=42.0
